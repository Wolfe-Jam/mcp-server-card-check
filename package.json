{
  "name": "mcp-server-card-check",
  "version": "0.3.4",
  "description": "Check an MCP server's Server Card (SEP-2127) and AI Catalog discovery against the spec, rule by rule.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "server-card",
    "sep-2127",
    "ai-catalog",
    "conformance",
    "validator",
    "discovery"
  ],
  "homepage": "https://github.com/Wolfe-Jam/mcp-server-card-check#readme",
  "bugs": {
    "url": "https://github.com/Wolfe-Jam/mcp-server-card-check/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wolfe-Jam/mcp-server-card-check.git"
  },
  "license": "MIT",
  "author": "James Wolfe",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "server-card-check": "dist/cli.js",
    "mcp-server-card-check": "dist/cli.js"
  },
  "main": "dist/discovery.js",
  "types": "dist/discovery.d.ts",
  "exports": {
    ".": {
      "types": "./dist/discovery.d.ts",
      "default": "./dist/discovery.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "default": "./dist/validate.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').copyFileSync('src/validator-standalone.cjs','dist/validator-standalone.cjs')\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "node --import tsx --test \"test/*.test.ts\" \"test/width/*.test.ts\"",
    "coverage:checks": "node scripts/check-coverage.mjs",
    "census:diff": "node scripts/census/diff.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "smoke": "node scripts/smoke-pack.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck && npm test && npm run smoke",
    "build:validator": "node scripts/build-validator.mjs",
    "dev:web": "wrangler dev",
    "deploy:web": "npm run build:validator && wrangler deploy"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^26.2.0",
    "hono": "^4.10.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.149.0"
  }
}
